[Unit]
Description=eForm order-import daemon (orders-in -> DB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pawel
Group=pawel
WorkingDirectory=/home/pawel/projects/eform-project/eform
Environment=ORDER_IMPORT_STANDALONE=1
# Optional: override cycle interval (seconds), default 30
# Environment=ORDER_IMPORT_INTERVAL_SEC=30
ExecStart=/home/pawel/.nvm/versions/node/v23.10.0/bin/node /home/pawel/projects/eform-project/eform/scripts/orderImportDaemon.js
Restart=always
RestartSec=5
# Daemon already writes import/import.log itself (utils/logging saveLogToFile).
# Send stdout/stderr to the journal so `journalctl -u eform-import` works and
# import.log is not written twice.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
