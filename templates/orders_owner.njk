{% extends "orders.njk" %}
{% block head %}
    <link rel="stylesheet" href="/styles/orders.css">
        <link rel="stylesheet" href="/styles/mobile/orders.css">
            <link rel="stylesheet" href="/styles/dialog.css">
                <link rel="stylesheet" href="/styles/mobile/dialog.css">
                    <link rel="stylesheet" href="/styles/owner/orders.css">
                    {% endblock head %}
                    {% block user_filter %}{% endblock %}
                    {% block users %}
                        <div class='d-flex'>
                            {% block all_orders_btn %}
                                <div id='showAllOrders-container' class='mt-3'>
                                    <a href='/orders/organization-orders' id='showAllOrdersBtn' class='action-btn action-btn-show-all'>
                                        <i class="fas fa-list me-2"></i>
                                        {{ __('orders.show_all_orders') }}
                                    </a>
                                </div>
                            {% endblock %}
                            {% if selectedUser %}
                                <div class="alert alert-info mt-3">
                                    <strong>Zamówienia użytkownika:</strong>
                                    {{ selectedUser.client_name }} ({{ selectedUserIdent }})
                                </div>
                            {% endif %}
                        </div>
                    {% endblock %}
                    {% block pagination %}
                        {% if range(totalPages).length > 1 %}
                            <nav aria-label="Paginate">
                                <ul class="pagination justify-content-center">
                                    {% for i in range(1, totalPages + 1) %}
                                        <li class="page-item {% if i == page %}active{% endif %}">
                                            {% if selectedUserIdent %}
                                                <a class="page-link" href="?userIdent={{ selectedUserIdent }}&page={{ i }}">{{ i }}</a>
                                            {% else %}
                                                <a class="page-link" href="?page={{ i }}">{{ i }}</a>
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                                <p>{{ __('orders.page_word') }}
                                    {{ page }} z {{ totalPages }}</p>
                            </nav>
                        {% endif %}
                    {% endblock %}
                    {% block scripts %}
                        <script type="module" src="/scripts/orders.js"></script>
                    {% endblock scripts %}