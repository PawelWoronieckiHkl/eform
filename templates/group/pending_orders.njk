{% extends "base.njk" %}
{% block title %}Oczekujące zamówienia{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/styles/group/shops.css">
{% endblock %}

{% block key_nav %}
    window.location.href = '/group/shops'
{% endblock %}

{% block back_link %}
    <button class="modern-back-btn" onclick="window.location.href='/group/shops'">
{% endblock %}

{% block content %}
    <div class="content col-9 center-content">
        <div class="container my-4">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="mb-0">Oczekujące zamówienia sklepów</h2>
                <a href="/group/shops" class="btn btn-outline-secondary btn-sm">
                    ← Wróć do sklepów
                </a>
            </div>

            {% if orders and orders.length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nr zamówienia</th>
                                <th>Sklep</th>
                                <th>Komisant</th>
                                <th>Komentarz</th>
                                <th>Data</th>
                                <th class="text-end">Akcje</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr>
                                    <td>
                                        <a href="/orders/order/{{ order.id }}" target="_blank" class="fw-semibold">
                                            {{ order.order_idx or order.id }}
                                        </a>
                                    </td>
                                    <td>{{ order.client_name }} <span class="text-muted small">({{ order.shop_ident }})</span></td>
                                    <td>{{ order.commission or '—' }}</td>
                                    <td class="text-muted small">{{ order.comment or '—' }}</td>
                                    <td class="text-muted small">{{ order.created_at | date if order.created_at else '—' }}</td>
                                    <td class="text-end">
                                        <button class="btn btn-success btn-sm me-1 js-approve-btn"
                                                data-order-id="{{ order.id }}">
                                            Zatwierdź i wyślij
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm js-reject-btn"
                                                data-order-id="{{ order.id }}">
                                            Odrzuć
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info" role="alert">
                    Brak oczekujących zamówień do zatwierdzenia.
                </div>
            {% endif %}

        </div>
    </div>

    {# Modal potwierdzenia zatwierdzenia #}
    <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="approveModalLabel">Zatwierdź zamówienie</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    Czy na pewno chcesz zatwierdzić i wysłać to zamówienie? Operacja jest nieodwracalna.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                    <button type="button" class="btn btn-success" id="approveConfirmBtn">Zatwierdź i wyślij</button>
                </div>
            </div>
        </div>
    </div>

    {# Modal potwierdzenia odrzucenia #}
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">Odrzuć zamówienie</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zamknij"></button>
                </div>
                <div class="modal-body">
                    Zamówienie zostanie cofnięte do statusu „aktywne" i sklep będzie mógł je edytować.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                    <button type="button" class="btn btn-danger" id="rejectConfirmBtn">Odrzuć</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/scripts/group/pending_orders.js"></script>
{% endblock %}
