{% extends "base.njk" %}
{% block title %}
    {% if mode === 'edit' %}Edytuj sklep{% else %}Dodaj sklep{% endif %}
{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/styles/group/shops.css">
{% endblock %}

{% block key_nav %}
    window.history.back()
{% endblock %}

{% block back_link %}
    <button class="modern-back-btn" onclick="window.history.back()">
{% endblock %}

{% block content %}
    <div class="content col-9 center-content">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow">
                    <div class="card-header bg-secondary text-white">
                        <h3 class="mb-0">
                            {% if mode === 'edit' %}
                                Edytuj sklep
                            {% else %}
                                Dodaj sklep
                            {% endif %}
                        </h3>
                    </div>
                    <div class="card-body">

                        {% if error %}
                            <div class="alert alert-danger">{{ error }}</div>
                        {% endif %}

                        <form method="POST"
                              action="{% if mode === 'edit' %}/group/shops/{{ shop.id }}{% else %}/group/shops{% endif %}">

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label for="ident" class="form-label required">Identyfikator</label>
                                    <input type="text"
                                           class="form-control"
                                           id="ident"
                                           name="ident"
                                           required
                                           maxlength="50"
                                           value="{{ shop.ident or '' }}"
                                           placeholder="np. TCNShop1">
                                    <small class="form-text text-muted">Unikalny identyfikator sklepu</small>
                                </div>

                                <div class="col-md-6">
                                    <label for="pin" class="form-label required">PIN (login)</label>
                                    <input type="text"
                                           class="form-control"
                                           id="pin"
                                           name="pin"
                                           required
                                           maxlength="50"
                                           value="{{ shop.pin or '' }}"
                                           placeholder="np. SHOP001"
                                           autocomplete="off">
                                    <small class="form-text text-muted">Używany do logowania w eFor</small>
                                </div>

                                <div class="col-md-6">
                                    <label for="tax_id" class="form-label">NIP</label>
                                    <input type="text"
                                           class="form-control"
                                           id="tax_id"
                                           name="tax_id"
                                           maxlength="20"
                                           value="{{ shop.tax_id or '' }}"
                                           placeholder="0000000000">
                                </div>

                                <div class="col-md-6">
                                    <label for="password" class="form-label {% if mode !== 'edit' %}required{% endif %}">
                                        Hasło{% if mode === 'edit' %} <small class="text-muted">(zostaw puste by nie zmieniać)</small>{% endif %}
                                    </label>
                                    <div class="input-group">
                                        <input type="password"
                                               class="form-control"
                                               id="password"
                                               name="password"
                                               {% if mode !== 'edit' %}required minlength="6"{% endif %}
                                               placeholder="{% if mode === 'edit' %}Nowe hasło (opcjonalnie){% else %}Hasło{% endif %}"
                                               autocomplete="new-password">
                                        <button class="btn btn-outline-secondary" type="button" id="toggle-password">
                                            <img class="icon" src="/img/eye.png" id="password-icon">
                                        </button>
                                    </div>
                                    {% if mode !== 'edit' %}
                                        <small class="form-text text-muted">Minimum 6 znaków</small>
                                    {% endif %}
                                </div>

                                <hr class="col-12 mt-2">
                                <p class="col-12 mb-0 fw-semibold text-secondary">Dane adresowe</p>

                                <div class="col-12">
                                    <label for="street" class="form-label">Ulica i numer</label>
                                    <input type="text"
                                           class="form-control"
                                           id="street"
                                           name="street"
                                           maxlength="200"
                                           value="{{ shop.street or '' }}"
                                           placeholder="ul. Przykładowa 1">
                                </div>

                                <div class="col-md-4">
                                    <label for="zip" class="form-label">Kod pocztowy</label>
                                    <input type="text"
                                           class="form-control"
                                           id="zip"
                                           name="zip"
                                           maxlength="20"
                                           value="{{ shop.zip or '' }}"
                                           placeholder="00-000">
                                </div>

                                <div class="col-md-8">
                                    <label for="city" class="form-label">Miasto</label>
                                    <input type="text"
                                           class="form-control"
                                           id="city"
                                           name="city"
                                           maxlength="100"
                                           value="{{ shop.city or '' }}"
                                           placeholder="Warszawa">
                                </div>

                                <div class="col-md-6">
                                    <label for="phone" class="form-label">Telefon</label>
                                    <input type="tel"
                                           class="form-control"
                                           id="phone"
                                           name="phone"
                                           maxlength="50"
                                           value="{{ shop.phone or '' }}"
                                           placeholder="+48 000 000 000">
                                </div>

                                <div class="col-md-6">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email"
                                           class="form-control"
                                           id="email"
                                           name="email"
                                           maxlength="100"
                                           value="{{ shop.email or '' }}"
                                           placeholder="sklep@example.com">
                                </div>

                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="/group/shops" class="btn btn-secondary">
                                    Anuluj
                                </a>
                                <button type="submit" class="btn btn-dark">
                                    {% if mode === 'edit' %}Zapisz zmiany{% else %}Dodaj sklep{% endif %}
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const toggle = document.getElementById('toggle-password');
        const input = document.getElementById('password');
        toggle?.addEventListener('click', () => {
            input.type = input.type === 'password' ? 'text' : 'password';
        });
    </script>
{% endblock %}
