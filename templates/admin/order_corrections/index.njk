{% extends "base.njk" %}
{% block head %}
    <link rel="stylesheet" href="/styles/admin/order_corrections.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
{% endblock head %}
{% block content %}
<div class="content">
    <div class="container mb-5 col-12 w-100 mobile-rm-card">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div>
                <a href="/admin" class="btn btn-outline-secondary btn-sm mb-2">&larr; Panel admina</a>
                <h2 class="mb-0">Korekty zamówień</h2>
                <p class="text-muted mb-0">Otwieraj wysłane zamówienia, przeliczaj ceny i wysyłaj korektę na FTP oraz mailem do klienta.</p>
            </div>
        </div>

        {% if inCorrection and inCorrection.length > 0 %}
        <div class="alert alert-warning">
            <strong><i class="bi bi-pencil-square me-1"></i>W trakcie korekty:</strong>
            {% for o in inCorrection %}
                <span class="in-correction-item d-inline-flex align-items-center ms-1">
                    <a href="/admin/order-corrections/{{ o.id }}" class="badge bg-warning text-dark" title="Otwórz widok korekty">#{{ o.order_idx }} ({{ o.user_ident }})</a>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-1 cancel-correction-btn" data-order-id="{{ o.id }}" title="Anuluj korektę — przywróć status wysłane" aria-label="Anuluj korektę #{{ o.order_idx }}">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </span>
            {% endfor %}
        </div>
        {% endif %}

        <form method="get" class="row g-2 mb-4">
            <div class="col-md-8">
                <input type="search" name="q" class="form-control" placeholder="Szukaj: nr zamówienia, klient, ident, zlecenie..." value="{{ q }}">
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Szukaj</button>
                {% if q %}<a href="/admin/order-corrections" class="btn btn-outline-secondary">Wyczyść</a>{% endif %}
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nr</th>
                        <th>Klient</th>
                        <th>Organizacja</th>
                        <th>Zlecenie</th>
                        <th>Wysłano</th>
                        <th>Ostatnia korekta</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% if orders and orders.length > 0 %}
                        {% for order in orders %}
                        <tr>
                            <td><strong>{{ order.order_idx }}</strong></td>
                            <td>{{ order.client_name }}<br><small class="text-muted">{{ order.user_ident }}</small></td>
                            <td>{{ order.org_ident }}</td>
                            <td>{{ order.commision or '—' }}</td>
                            <td>{{ order.sent_date or '—' }}</td>
                            <td>{{ order.corrected_at or '—' }}</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-warning open-correction-btn" data-order-id="{{ order.id }}">
                                    <i class="bi bi-unlock me-1"></i>Otwórz do korekty
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-4">Brak wysłanych zamówień{% if q %} dla „{{ q }}"{% endif %}.</td></tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
        {% set windowStart = page - 3 if page - 3 > 1 else 1 %}
        {% set windowEnd = page + 3 if page + 3 < totalPages else totalPages %}
        <nav aria-label="Paginacja">
            <ul class="pagination justify-content-center">
                <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                    <a class="page-link" href="?page={{ page - 1 }}{% if q %}&q={{ q }}{% endif %}" aria-label="Poprzednia">&laquo;</a>
                </li>
                {% if windowStart > 1 %}
                    <li class="page-item"><a class="page-link" href="?page=1{% if q %}&q={{ q }}{% endif %}">1</a></li>
                    {% if windowStart > 2 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                {% endif %}
                {% for i in range(windowStart, windowEnd + 1) %}
                <li class="page-item {% if i == page %}active{% endif %}">
                    <a class="page-link" href="?page={{ i }}{% if q %}&q={{ q }}{% endif %}">{{ i }}</a>
                </li>
                {% endfor %}
                {% if windowEnd < totalPages %}
                    {% if windowEnd < totalPages - 1 %}<li class="page-item disabled"><span class="page-link">…</span></li>{% endif %}
                    <li class="page-item"><a class="page-link" href="?page={{ totalPages }}{% if q %}&q={{ q }}{% endif %}">{{ totalPages }}</a></li>
                {% endif %}
                <li class="page-item {% if page >= totalPages %}disabled{% endif %}">
                    <a class="page-link" href="?page={{ page + 1 }}{% if q %}&q={{ q }}{% endif %}" aria-label="Następna">&raquo;</a>
                </li>
            </ul>
        </nav>
        {% endif %}
    </div>
</div>
{% endblock content %}
{% block scripts %}
<script type="module" src="/scripts/admin/orderCorrections.js"></script>
{% endblock scripts %}
