{% extends "base.njk" %}

{% block head %}
    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="/styles/mobile/home.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .admin-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            border: 1px solid #e9ecef;
        }

        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .admin-card .card-title {
            color: #2c3e50;
            font-weight: 600;
        }

        .admin-card .card-text {
            color: #6c757d;
            flex-grow: 1;
        }

        .admin-card .btn {
            min-width: 120px;
        }

        .admin-card i {
            color: #6c757d;
        }

        h2 {
            color: #2c3e50;
            font-weight: 700;
            border-bottom: 3px solid #6c757d;
            padding-bottom: 10px;
            display: inline-block;
        }
    </style>
    <script>
        // Add home page identifier to body
        document.addEventListener('DOMContentLoaded', function () {
            document
                .body
                .classList
                .add('home-page');
        });
    </script>
{% endblock head %}

{% block content %}
    <div class="content">
        <div class="container mb-5 col-12 w-100 mobile-rm-card">
            <div class="row">
                <div class="col-12">
                    <h2 class="mb-4">Panel Administracyjny</h2>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-4 col-md-6 col-12">
                    <div class="d-flex flex-column gap-3">
                        <!-- Podgląd logowań klientów -->
                        <div class="card admin-card">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <i class="bi bi-clock-history me-2"></i>
                                    Historia Logowań
                                </h5>
                                <p class="card-text">Przeglądaj historię logowań wszystkich użytkowników</p>
                                <a href="/admin/login-history" class="btn btn-primary mt-auto">
                                    Zobacz
                                </a>
                            </div>
                        </div>

                        <!-- Raporty zamówień -->
                        <div class="card admin-card">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <i class="bi bi-graph-up me-2"></i>
                                    Raporty Zamówień
                                </h5>
                                <p class="card-text">Statystyki i raporty dotyczące zamówień</p>
                                <a href="/admin/reports" class="btn btn-secondary mt-auto">
                                    Zobacz Raporty
                                </a>
                            </div>
                        </div>

                        <!-- Logi systemowe -->
                        <div class="card admin-card">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">
                                    <i class="bi bi-file-text me-2"></i>
                                    Logi Systemowe
                                </h5>
                                <p class="card-text">Przeglądanie logów systemowych i błędów</p>
                                <a href="/admin/logs" class="btn btn-secondary mt-auto">
                                    Zobacz Logi
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}

{% block scripts %}{% endblock scripts %}