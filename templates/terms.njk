{% extends "base.njk" %}
{% block title %}
    {{ __('new-order.page_title') }}
{% endblock title %}
{% block key_nav %}
    window.history.back()
{% endblock %}
{% block back_link %}
    <button class="modern-back-btn" onclick="window.history.back()">
    {% endblock %}
    {% block head %}
        <link rel="stylesheet" href="/styles/new-order.css">
        <link rel="stylesheet" href="/styles/dialog.css">
        <link rel="stylesheet" href="/styles/mobile/new-order.css">
        <link rel="stylesheet" href="/styles/mobile/dialog.css">
    {% endblock head %}
    {% block content %}
        <div class="content center-content">
            <div class="container my-5 col-7 p-5 text-start mobile-rm-card rm-col-7 rm-p-5">
                <div class="row justify-content-center">
                    <h2 class="p-3">
                        {% block order_title %}{{ __('site.terms') }}
                        {% endblock order_title %}
                    </h2>

                    <div class="row justify-content-center">
                        <div class="privacy-content">
                            {{ contentHtml | safe }}
                        </div>
                    </div>
                </div>
            </div>
        {%endblock content%}