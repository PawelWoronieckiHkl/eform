{% block head %}
    <link rel="stylesheet" href="/styles/order_details.css">
        <link rel="stylesheet" href="/styles/order_sent.css">
            <link rel="stylesheet" href="/styles/mobile/order_sent.css">
                <link rel="stylesheet" href="/styles/dialog.css">
                    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/canvg@3.0.10/lib/umd.min.js"></script>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                {% endblock head %}
                {% extends "order.njk" %}
                {% block order_del_btn %}{% endblock %}
                {% block order_title %}
                    {{ __('history_order.title') }}
                {% endblock %}
                {% block table_style %}
                    <table class="table align-left table-striped order-table">
                        <thead class='thead-dark'>
                        {% endblock %}
                        {% block item_redirect %}
                            <tr style="cursor: pointer" onclick="window.location.href='/position/{{ rowObj.item.id }}'">
                            {% endblock %}
                            {% block btns_head %}{% endblock %}
                            {% block pos_btns %}{% endblock %}
                            {% block extra_rows %}
                            {% set statusIdx = globalIndex - 1 %}
                                {% if statuses[statusIdx] %}
                                    <tr class="status-row" id='status-row-{{ statuses[statusIdx].order_pos }}'>
                                        <td class="status-cell" colspan="100%">
                                            <div class="status-cards">
                                                <div class="status-card status-card-main" data-status="{{ statuses[statusIdx].status }}">
                                                    <div class="status-card-header">
                                                        <span class="status-indicator"></span>
                                                        <span class="status-card-label">{{ __('order.status_label') }}</span>
                                                    </div>
                                                    <div class="status-card-value">{{ __(statuses[statusIdx].status) }}</div>
                                                </div>
                                                <div class="status-card">
                                                    <div class="status-card-header">
                                                        <span class="status-card-label">{{ __('order.shipping_date_label') }}</span>
                                                    </div>
                                                    <div class="status-card-value">{{ (statuses[statusIdx].shipping_date) }}</div>
                                                </div>
                                                {% if statuses[statusIdx].parcel_href %}
                                                    <div class="status-card" id='parcel-link-card'>
                                                        <div class="status-card-header">
                                                            <span class="status-card-label">{{ __('order.shipping_method_label') }}</span>
                                                        </div>
                                                        <a href="{{ statuses[statusIdx].parcel_href }}" id='parcel-link' target="_blank" rel="noopener noreferrer">
                                                            <div class="status-card-value status-card-code">
                                                                <img src="/img/express-delivery.png" alt="delivery icon" class="icon ms-1">
                                                                    <span>
                                                                        {{ statuses[statusIdx].parcel_code }}</span>
                                                                </div>
                                                            </div>
                                                        </a>
                                                    {% else %}
                                                        <div class="status-card">
                                                            <div class="status-card-header">
                                                                <span class="status-card-label">{{ __('order.shipping_method_label') }}</span>
                                                            </div>
                                                            <div class="status-card-value status-card-code">{{ statuses[statusIdx].parcel_code }}</div>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr class="status-row" id='status-row-{{ rowObj.item.id }}'>
                                        <td class="status-cell" colspan="100%">
                                            <div class="status-cards">
                                                <div class="status-card status-card-main" data-status="default">
                                                    <div class="status-card-header">
                                                        <span class="status-indicator"></span>
                                                        <span class="status-card-label">{{ __('order.status_label') }}</span>
                                                    </div>
                                                    <div class="status-card-value">{{ __('order.status_order_sent') }}</div>
                                                </div>
                                                <div class="status-card">
                                                    <div class="status-card-header">
                                                        <span class="status-card-label">{{ __('order.shipping_date_label') }}</span>
                                                    </div>
                                                    <div class="status-card-value">-</div>
                                                </div>
                                                <div class="status-card">
                                                    <div class="status-card-header">
                                                        <span class="status-card-label">{{ __('order.shipping_method_label') }}</span>
                                                    </div>
                                                    <div class="status-card-value status-card-code">-</div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            {% endblock %}
                            {% block new_pos_btn %}
                            {% endblock %}
                            {% block send_order_btn %}{% endblock %}
                            {% block order_space %}
                                <div class="floating-history-order">
                                {% endblock %}
                                {% block scripts %}
                                    <script type='module' src="/scripts/order.js"></script>
                                    <script src="/scripts/mobileCards.js"></script>
                                    <script type='module' src="/scripts/order_sent.js"></script>
                                    <script>
                                        let orderHistoryNavBtn = document.getElementById('orders-history-nav-btn');
                                        if (orderHistoryNavBtn) {
                                            orderHistoryNavBtn.classList.add('active');
                                        }
                                    </script>
                                {% endblock %}
                                {% block edit_order_btn %}{% endblock %}