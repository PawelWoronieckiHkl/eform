{% extends "base.njk" %}
{% block title %}Edytuj Pracownika{% endblock title %}
{% block head %}
    <link rel="stylesheet" href="/styles/edit_employye.css">
    {% endblock head %}
    {% block key_nav %}
        window.history.back()
    {% endblock %}
    {% block back_link %}
        <button class="modern-back-btn" onclick="window.history.back()">
        {% endblock %}
        {% block content %}
            <div class="content col-9 center-content">
                <div class="row justify-content-center">
                    <div class="col-md-5 col-lg-5">
                        <div class="card shadow">
                            <div class="card-header bg-secondary text-white">
                                <h3 class="mb-0">
                                    <i class="fas fa-user"></i>
                                    {{ __('employee.employee_details') or 'Dane Pracownika' }}
                                </h3>
                            </div>
                            <div
                                class="card-body">
                                <div
                                    id="view-mode">
                                    <div class="section-header mb-3">
                                        <h5 class="text-secondary">
                                            <i class="fas fa-id-card"></i>
                                            {{ __('employee.personal_data') or 'Dane osobowe' }}
                                        </h5>
                                        <hr></div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">{{ __('employee.name') or 'Imię' }}</label>
                                                <div class="form-control-plaintext fw-bold" id="view-name">{{ employee.name }}</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted">{{ __('employee.surname') or 'Nazwisko' }}</label>
                                                <div class="form-control-plaintext fw-bold" id="view-surname">{{ employee.surname }}</div>
                                            </div>
                                        </div>
                                        <div class="mb-3 col-12">
                                            <label class="form-label text-muted">{{ __('employee.login') or 'Login' }}</label>
                                            <div class="form-control-plaintext fw-bold" id="view-login">{{ employee.login }}</div>
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label text-muted">{{ __('employee.phone') or 'Telefon' }}</label>
                                            <div class="form-control-plaintext fw-bold" id="view-phone">{{ employee.phone or '-' }}</div>
                                        </div>
                                        <div class="section-header mb-3">
                                            <h5 class="text-secondary">
                                                <i class="fas fa-key"></i>
                                                {{ __('employee.password') or 'Hasło' }}
                                            </h5>
                                            <hr></div>
                                            <div class="mb-4">
                                                <label class="form-label text-muted">{{ __('login.password_label') or 'Hasło' }}</label>
                                                <div class="form-control-plaintext">••••••••</div>
                                            </div>

                                            <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                                                <a href="/user/employee-panel" class="btn btn-secondary">
                                                    <i class="fas fa-arrow-left"></i>
                                                    {{ __('base.back_button') or 'Wróć' }}
                                                </a>
                                                <button type="button" class="btn btn-dark" id="edit-mode-btn">
                                                    <i class="fas fa-edit"></i>
                                                    {{ __('order.edit') or 'Edytuj' }}
                                                </button>
                                            </div>
                                        </div>
                                        <form
                                            id="edit-employee-form" style="display: none;">
                                            <div class="section-header mb-3">
                                                <h5 class="text-secondary">
                                                    <i class="fas fa-id-card"></i>
                                                    {{ __('employee.personal_data') or 'Dane osobowe' }}
                                                </h5>
                                                <hr></div>
                                                <div class="ms-1 row mb-3">
                                                    <div class="col-md-6">
                                                        <label for="name" class="form-label required">
                                                            {{ __('employee.name') or 'Imię' }}
                                                        </label>
                                                        <input type="text" class="form-control" id="name" name="name" value="{{ employee.name }}" required="required" placeholder="{{ __('employee.name') or 'Wprowadź imię' }}"></div>
                                                        <div class="col-md-6">
                                                            <label for="surname" class="form-label required">
                                                                {{ __('employee.surname') or 'Nazwisko' }}
                                                            </label>
                                                            <input type="text" class="form-control" id="surname" name="surname" value="{{ employee.surname }}" required="required" placeholder="{{ __('employee.surname') or 'Wprowadź nazwisko' }}"></div>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label for="login" class="form-label required">
                                                                {{ __('employee.login') or 'Login' }}
                                                            </label>
                                                            <input type="text" class="form-control w-100" id="login" name="login" value="{{ employee.login }}" required="required" placeholder="{{ __('employee.login') or 'Wprowadź login' }}">
                                                                <small class="form-text text-muted">
                                                                    {{ __('employee.login_hint') or 'Login będzie używany do logowania' }}
                                                                </small>
                                                            </div>
                                                            <div class="mb-4">
                                                                <label for="phone" class="form-label">
                                                                    {{ __('employee.phone') or 'Telefon' }}
                                                                </label>
                                                                <input type="tel" class="form-control" id="phone" name="phone" value="{{ employee.phone or '' }}" placeholder="{{ __('employee.phone') or 'Wprowadź numer telefonu' }}">
                                                                    <small class="form-text text-muted">
                                                                        {{ __('employee.phone_hint') or 'Opcjonalne' }}
                                                                    </small>
                                                                </div>
                                                                <!-- Zmiana hasła -->
                                                                <div class="section-header mb-3">
                                                                    <h5 class="text-secondary">
                                                                        <i class="fas fa-key"></i>
                                                                        {{ __('employee.change_password') or 'Zmiana hasła' }}
                                                                    </h5>
                                                                    <hr></div>
                                                                    <div class="mb-3">
                                                                        <div class="form-check form-switch mb-3">
                                                                            <input class="form-check-input" type="checkbox" id="change-password-toggle">
                                                                                <label class="form-check-label" for="change-password-toggle">
                                                                                    <strong>{{ __('employee.want_change_password') or 'Chcę zmienić hasło' }}</strong>
                                                                                </label>
                                                                            </div>
                                                                            <div id="password-fields" style="display: none;">
                                                                                <div class="mb-3">
                                                                                    <label for="password" class="form-label">
                                                                                        {{ __('employee.new_password') or 'Nowe hasło' }}
                                                                                    </label>
                                                                                    <div class="input-group">
                                                                                        <input type="password" class="form-control" id="password" name="password" minlength="6" placeholder="{{ __('employee.new_password') or 'Wprowadź nowe hasło' }}">
                                                                                            <button class="btn btn-outline-secondary" type="button" id="toggle-password">
                                                                                                <i class="fas fa-eye" id="password-icon"></i>
                                                                                            </button>
                                                                                        </div>
                                                                                        <small class="form-text text-muted">
                                                                                            {{ __('employee.password_hint') or 'Minimum 6 znaków' }}
                                                                                        </small>
                                                                                    </div>
                                                                                    <div class="mb-3">
                                                                                        <label for="password-confirm" class="form-label">
                                                                                            {{ __('employee.confirm_password') or 'Potwierdź hasło' }}
                                                                                        </label>
                                                                                        <div class="input-group">
                                                                                            <input type="password" class="form-control" id="password-confirm" name="password-confirm" minlength="6" placeholder="{{ __('employee.confirm_password') or 'Powtórz nowe hasło' }}">
                                                                                                <button class="btn btn-outline-secondary" type="button" id="toggle-password-confirm">
                                                                                                    <i class="fas fa-eye" id="password-confirm-icon"></i>
                                                                                                </button>
                                                                                            </div>
                                                                                            <div id="password-match-message" class="form-text"></div>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                                <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                                                                                    <button type="button" class="btn btn-secondary" id="cancel-edit-btn">
                                                                                        <i class="fas fa-times"></i>
                                                                                        {{ __('order.cancel') or 'Anuluj' }}
                                                                                    </button>
                                                                                    <button type="submit" class="btn btn-dark" id="submit-btn">
                                                                                        <i class="fas fa-save"></i>
                                                                                        {{ __('employee.save') or 'Zapisz zmiany' }}
                                                                                    </button>
                                                                                </div>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endblock content %}
                                                    {% block scripts %}
                                                        <script type="module" src="/scripts/edit_employee.js"></script>
                                                    {% endblock scripts %}