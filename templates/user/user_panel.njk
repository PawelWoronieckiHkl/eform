{% extends "base.njk" %}
{% block title %}Panel Pracowników{% endblock title %}
{% block head %}
    <link rel="stylesheet" href="/styles/user_panel.css">
    {% endblock head %}
    {% block key_nav %}
        window.location.href='/'
    {% endblock %}
    {% block back_link %}
        <button class="modern-back-btn" onclick="window.location.href='/'">
        {% endblock %}
        {% block content %}
            <div class="content  col-9 center-content">
                <div class="container my-5 mobile-rm-card">
                    <div class="employee-panel-header mb-4">
                        <h2 class="text-center mb-3">
                            <i class="fas fa-users"></i>
                            {{ __('employee.panel_title') or 'Zarządzanie Pracownikami' }}
                        </h2>
                        <div class="d-flex justify-content-end mb-3">
                            <a href="/user/employee/add" class="action-btn action-btn-add">
                                <i class="fas fa-user-plus me-2"></i>
                                {{ __('employee.add_employee') or 'Dodaj Pracownika' }}
                            </a>
                        </div>
                    </div>
                    <div class="employees-container">
                        {% if employees and employees.length > 0 %}

                            {# ── DESKTOP: tabela ────────────────────────────────── #}
                            <div class="table-responsive d-none d-md-block">
                                <table class="table table-hover table-bordered employee-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>{{ __('employee.name') or 'Imię' }}</th>
                                            <th>{{ __('employee.surname') or 'Nazwisko' }}</th>
                                            <th>{{ __('employee.login') or 'Login' }}</th>
                                            <th>{{ __('employee.phone') or 'Telefon' }}</th>
                                            <th>{{ __('employee.last_login') or 'Ostatnie logowanie' }}</th>
                                            <th class="text-center">{{ __('employee.can_send_orders') or 'Wysyłanie zamówień' }}</th>
                                            <th class="text-center">{{ __('employee.can_see_prices') or 'Widoczność cen' }}</th>
                                            <th class="text-center">{{ __('employee.price_factor') or 'Faktor cen' }}</th>
                                            <th class="text-center">{{ __('employee.can_see_all_orders') or 'Wszystkie zamówienia' }}</th>
                                            <th class="text-center">{{ __('employee.actions') or 'Akcje' }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for employee in employees %}
                                            <tr class="employee-row" data-employee-id="{{ employee.id }}">
                                                <td>{{ loop.index }}</td>
                                                <td>{{ employee.name }}</td>
                                                <td>{{ employee.surname }}</td>
                                                <td>{{ employee.login }}</td>
                                                <td>{{ employee.phone or '-' }}</td>
                                                <td>{{ employee.last_login or __('employee.never') or 'Nigdy' }}</td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input permission-toggle"
                                                        data-employee-id="{{ employee.id }}"
                                                        data-permission="can_send_orders"
                                                        {% if employee.can_send_orders %}checked{% endif %}>
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input permission-toggle"
                                                        data-employee-id="{{ employee.id }}"
                                                        data-permission="can_see_prices"
                                                        {% if employee.can_see_prices %}checked{% endif %}>
                                                </td>
                                                <td class="text-center">
                                                    <input type="number" class="form-control form-control-sm price-factor-input"
                                                        data-employee-id="{{ employee.id }}"
                                                        value="{{ employee.price_factor or '1.00' }}"
                                                        min="0.01" max="99.99" step="0.01"
                                                        style="width: 75px; margin: 0 auto;"
                                                        {% if not employee.can_see_prices %}disabled{% endif %}>
                                                </td>
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input permission-toggle"
                                                        data-employee-id="{{ employee.id }}"
                                                        data-permission="can_see_all_orders"
                                                        {% if employee.can_see_all_orders %}checked{% endif %}>
                                                </td>
                                                <td class="text-center">
                                                    <div class="action-buttons">
                                                        <a href="/user/employee/{{ employee.id }}/orders" class="action-btn action-btn-view-orders">
                                                            <i class="fas fa-shopping-cart me-2"></i>
                                                            {{ __('employee.view_orders') or 'Zobacz zamówienia' }}
                                                        </a>
                                                        <div class='manage-worker-container d-flex justify-content-center gap-2'>
                                                            <button class="action-btn action-btn-delete delete-employee-btn" data-id="{{ employee.id }}" data-name="{{ employee.name }} {{ employee.surname }}">
                                                                <i class="fas fa-trash me-2"></i>
                                                                {{ __('employee.delete') or 'Usuń pracownika' }}
                                                            </button>
                                                            <a href="/user/employee/edit/{{ employee.id }}" class="action-btn action-btn-edit edit-employee-btn" data-id="{{ employee.id }}" data-name="{{ employee.name }} {{ employee.surname }}">
                                                                <i class="fas fa-edit me-2"></i>
                                                                {{ __('employee.edit') or 'Edytuj pracownika' }}
                                                            </a>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>

                            {# ── MOBILE: accordion ──────────────────────────────── #}
                            <div class="accordion d-md-none" id="employeeAccordion">
                                {% for employee in employees %}
                                    <div class="accordion-item employee-row employee-card" data-employee-id="{{ employee.id }}">
                                        <h2 class="accordion-header" id="empHeading{{ employee.id }}">
                                            <button class="accordion-button collapsed employee-accordion-btn" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#empCollapse{{ employee.id }}"
                                                aria-expanded="false"
                                                aria-controls="empCollapse{{ employee.id }}">
                                                <span class="emp-card-name">
                                                    <i class="fas fa-user me-2 emp-card-icon"></i>
                                                    {{ employee.name }} {{ employee.surname }}
                                                </span>
                                            </button>
                                        </h2>
                                        <div id="empCollapse{{ employee.id }}" class="accordion-collapse collapse"
                                            aria-labelledby="empHeading{{ employee.id }}"
                                            data-bs-parent="#employeeAccordion">
                                            <div class="accordion-body emp-card-body">

                                                <dl class="emp-info-list">
                                                    <dt>{{ __('employee.login') or 'Login' }}</dt>
                                                    <dd>{{ employee.login }}</dd>

                                                    <dt>{{ __('employee.phone') or 'Telefon' }}</dt>
                                                    <dd>{{ employee.phone or '-' }}</dd>

                                                    <dt>{{ __('employee.last_login') or 'Ostatnie logowanie' }}</dt>
                                                    <dd>{{ employee.last_login or __('employee.never') or 'Nigdy' }}</dd>
                                                </dl>

                                                <div class="emp-permissions">
                                                    <p class="emp-permissions-title">{{ __('employee.permissions') or 'Uprawnienia' }}</p>

                                                    <label class="emp-permission-row">
                                                        <input type="checkbox" class="form-check-input permission-toggle"
                                                            data-employee-id="{{ employee.id }}"
                                                            data-permission="can_send_orders"
                                                            {% if employee.can_send_orders %}checked{% endif %}>
                                                        <span>{{ __('employee.can_send_orders') or 'Wysyłanie zamówień' }}</span>
                                                    </label>

                                                    <label class="emp-permission-row">
                                                        <input type="checkbox" class="form-check-input permission-toggle"
                                                            data-employee-id="{{ employee.id }}"
                                                            data-permission="can_see_prices"
                                                            {% if employee.can_see_prices %}checked{% endif %}>
                                                        <span>{{ __('employee.can_see_prices') or 'Widoczność cen' }}</span>
                                                    </label>

                                                    <label class="emp-permission-row">
                                                        <span>{{ __('employee.price_factor') or 'Faktor cen' }}</span>
                                                        <input type="number" class="form-control form-control-sm price-factor-input emp-factor-input"
                                                            data-employee-id="{{ employee.id }}"
                                                            value="{{ employee.price_factor or '1.00' }}"
                                                            min="0.01" max="99.99" step="0.01"
                                                            {% if not employee.can_see_prices %}disabled{% endif %}>
                                                    </label>

                                                    <label class="emp-permission-row">
                                                        <input type="checkbox" class="form-check-input permission-toggle"
                                                            data-employee-id="{{ employee.id }}"
                                                            data-permission="can_see_all_orders"
                                                            {% if employee.can_see_all_orders %}checked{% endif %}>
                                                        <span>{{ __('employee.can_see_all_orders') or 'Wszystkie zamówienia' }}</span>
                                                    </label>
                                                </div>

                                                <div class="emp-card-actions">
                                                    <a href="/user/employee/{{ employee.id }}/orders" class="action-btn action-btn-view-orders w-100 justify-content-center">
                                                        <i class="fas fa-shopping-cart me-2"></i>
                                                        {{ __('employee.view_orders') or 'Zobacz zamówienia' }}
                                                    </a>
                                                    <div class="d-flex gap-2 mt-2">
                                                        <a href="/user/employee/edit/{{ employee.id }}" class="action-btn action-btn-edit edit-employee-btn flex-grow-1 justify-content-center" data-id="{{ employee.id }}" data-name="{{ employee.name }} {{ employee.surname }}">
                                                            <i class="fas fa-edit me-2"></i>
                                                            {{ __('employee.edit') or 'Edytuj' }}
                                                        </a>
                                                        <button class="action-btn action-btn-delete delete-employee-btn flex-grow-1 justify-content-center" data-id="{{ employee.id }}" data-name="{{ employee.name }} {{ employee.surname }}">
                                                            <i class="fas fa-trash me-2"></i>
                                                            {{ __('employee.delete') or 'Usuń' }}
                                                        </button>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                        {% else %}
                            <div class="alert" role="alert">
                                <i class="fas fa-info-circle"></i>
                                <p class="mb-2">{{ __('employee.no_employees') or 'Brak pracowników do wyświetlenia' }}</p>
                                <a href="/user/employee/add" class="action-btn action-btn-add">
                                <i class="fas fa-user-plus me-2"></i>
                                {{ __('employee.add_first') or 'Dodaj pierwszego pracownika' }}
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <dialog id="delete-dialog" class="delete-dialog">
                    <div class="dialog-content">
                        <h3 id="dialog-title">{{ __('orders.are_you_sure') or 'Potwierdź usunięcie' }}</h3>
                        <p id="dialog-message"></p>
                        <div class="dialog-buttons">
                            <button id="cancel-btn" class="btn btn-secondary">{{ __('order.cancel') or 'Anuluj' }}</button>
                            <button id="confirm-btn" class="btn btn-danger">{{ __('employee.delete') or 'Usuń' }}</button>
                        </div>
                    </div>
                </dialog>
            </div>
        {% endblock content %}
        {% block scripts %}
            <script type="module" src="/scripts/user_panel.js"></script>
        {% endblock scripts %}