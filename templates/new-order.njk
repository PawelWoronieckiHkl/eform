                                                        {# {% endblock city_input %} #}
                                                        {# </div> #}
                                                        {# </div> #}
                                                        {# <div class="row mb-3 align-items-center new-addr d-none"> #}
                                                        {# <div class="col-md-3 text-start fw-semibold"> #}
                                                        {# <label for="zip">{{ __('new-order.zip') }}</label> #}
                                                        {# </div> #}
                                                        {# <div class="col-md-9"> #}
                                                        {# {% block zip_input %} #}
                                                        {# <input type="text" class="form-control" id="zip" placeholder="{{ __('new-order.zip_placeholder') }}" value=""/> #}
