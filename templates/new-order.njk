                        {% endblock content %}
                        {% block scripts %}
                            <script src="/vendor/country-select-js/build/js/countrySelect.min.js"></script>
                            <script>
                                let neworderbtn = document.getElementById('new-order-nav-btn');
                                if (neworderbtn) {
                                    neworderbtn.classList.add('active');
                                }
                                $(function () {
                                    $("#country").countrySelect({
                                        preferredCountries: [
                                            "pl",
                                            "de",
                                            "gb",
                                            'nl',
                                            'fr'
                                        ],
                                        defaultCountry: "pl"
                                    });
                                });
                                $(function () {
                                    $("#sendCountry").countrySelect({
                                        preferredCountries: [
                                            "pl",
                                            "de",
                                            "gb",
                                            'nl',
                                            'fr'
                                        ],
                                        defaultCountry: "pl"
                                    });
                                });
                            </script>
                            <script type="module" src="/scripts/orders.js"></script>
                            <script type="module" src="/scripts/createNewAddress.js"></script>
                        {% endblock scripts %}