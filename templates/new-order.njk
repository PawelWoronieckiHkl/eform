                                                <div class="row mb-3 align-items-center new-send-addr d-none">
                                                    <div class="col-md-3 text-start fw-semibold">
                                                        <label for="sendCountry">{{ __('new-order.country') }}</label>
                                                    </div>
                                                    <div class="col-md-9">
                                                        {% block send_country_input %}
